{
  "name": "iobroker.vis-metro",
  "description": "Metro Widgets for ioBroker.vis",
  "version": "1.2.0",
  "author": {
    "name": "hobbyquaker",
    "email": "hq@ccu.io"
  },
  "contributors": [
    "bluefox <dogafox@gmail.com>",
    "hobbyquaker <hq@ccu.io>"
  ],
  "homepage": "https://github.com/ioBroker/ioBroker.vis-metro",
  "repository": {
    "type": "git",
    "url": "https://github.com/ioBroker/ioBroker.vis-metro"
  },
  "licenses": [
    {
      "type": "MIT",
      "url": "https://github.com/ioBroker/ioBroker.vis-metro/blob/master/LICENSE"
    }
  ],
  "keywords": [
    "ioBroker",
    "GUI",
    "DashUI",
    "web interface",
    "home automation",
    "SCADA",
    "metro GUI"
  ],
  "devDependencies": {
    "@alcalzone/release-script": "^5.1.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.1.2",
    "@alcalzone/release-script-plugin-license": "^5.1.1",
    "@iobroker/build-tools": "^3.0.3",
    "@iobroker/eslint-config": "^2.2.0",
    "@iobroker/testing": "^5.2.2"
  },
  "bugs": {
    "url": "https://github.com/ioBroker/ioBroker.vis-metro/issues"
  },
  "main": "widgets/metro.html",
  "files": [
    "admin/",
    "img/",
    "widgets/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "node tasks",
    "copy-files": "node tasks --copy-files",
    "tsc": "cd src-widgets && npx tsc",
    "preview": "cd src-widgets && npm run preview",
    "preview:diff": "cd src-widgets && node preview/diff.mjs",
    "preview:images": "cd src-widgets && node preview/images.mjs",
    "check-widgets": "cd src-widgets && node tools/checkWidgets.mjs",
    "palette": "cd src-widgets && node tools/generate.mjs",
    "palette:verify": "cd src-widgets && node tools/generate.mjs --verify",
    "icons": "cd src-widgets && node tools/extractIcons.mjs",
    "lint": "eslint -c eslint.config.mjs",
    "test": "mocha --exit",
    "test:integration": "mocha --exit",
    "test:package": "mocha test/testPackageFiles --exit",
    "npm": "npm i && cd src-widgets && npm i",
    "update-packages": "npx -y npm-check-updates --upgrade && cd src-widgets && npx -y npm-check-updates --upgrade",
    "release": "release-script",
    "release-patch": "release-script patch --yes --no-update-lockfile",
    "release-minor": "release-script minor --yes --no-update-lockfile",
    "release-major": "release-script major --yes --no-update-lockfile"
  },
  "license": "MIT"
}
